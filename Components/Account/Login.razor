@page "/login"

<h3>Login</h3>

<form method="post" action="/account/login">

    <div class="mb-3">
        <label>Email</label>

        <input class="form-control"
               name="email" />
    </div>


    <div class="mb-3">
        <label>Password</label>

        <input class="form-control"
               type="password"
               name="password" />
    </div>


    <button class="btn btn-primary"
            type="submit">
        Login
    </button>

</form>
